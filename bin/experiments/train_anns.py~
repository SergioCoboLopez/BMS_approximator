input_path= '../../data/alternative_experiments/%s/noisy_data/%s/' % (net_architecture,str(step))
filename='NN_%s_%s_sigma_%s_r_%s_step_%s.csv' % \
    (function, net_architecture, sigma, realization, str(step))
data=input_path+filename

